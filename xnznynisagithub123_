    <!-- JAVASCRIPT -->
    <script>

        // AUTOMATIC YEAR
        document.getElementById("currentYear").textContent =
            new Date().getFullYear();


        // MOBILE NAVIGATION
        const menuToggle = document.getElementById("menuToggle");
        const navLinks = document.getElementById("navLinks");

        menuToggle.addEventListener("click", () => {

            const isOpen = navLinks.classList.toggle("active");

            menuToggle.setAttribute("aria-expanded", isOpen);

            menuToggle.textContent = isOpen ? "✕" : "☰";

        });

        // Close menu after clicking a navigation link
        document.querySelectorAll(".nav-links a").forEach(link => {

            link.addEventListener("click", () => {

                navLinks.classList.remove("active");

                menuToggle.textContent = "☰";

                menuToggle.setAttribute("aria-expanded", "false");

            });

        });


        // MUSIC PLAYER
        const music = document.getElementById("backgroundMusic");
        const musicButton = document.getElementById("musicButton");
        const recordIcon = document.getElementById("recordIcon");
        const musicTooltip = document.getElementById("musicTooltip");

        let musicStarted = false;

        async function playMusic() {

            try {

                await music.play();

                musicStarted = true;

                musicButton.classList.add("playing");

                musicButton.setAttribute("aria-pressed", "true");
                musicButton.setAttribute("aria-label", "Jeda musik");

                musicTooltip.textContent = "Now Playing: Heaven ♡";

            } catch (error) {

                console.log("Autoplay belum diizinkan browser.");

                musicButton.classList.remove("playing");

            }

        }

        function pauseMusic() {

            music.pause();

            musicButton.classList.remove("playing");

            musicButton.setAttribute("aria-pressed", "false");
            musicButton.setAttribute("aria-label", "Putar musik");

            musicTooltip.textContent = "Play my favorite song ♡";

        }

        // Attempt autoplay when the page opens
        window.addEventListener("load", () => {

            playMusic();

        });

        // Try again on the first user interaction if autoplay was blocked
        function firstInteraction() {

            if (!musicStarted) {
                playMusic();
            }

            document.removeEventListener("pointerdown", firstInteraction);
            document.removeEventListener("keydown", firstInteraction);

        }

        document.addEventListener("pointerdown", firstInteraction);
        document.addEventListener("keydown", firstInteraction);

        // Floating music button
        musicButton.addEventListener("click", () => {

            if (music.paused) {

                playMusic();

            } else {

                pauseMusic();

            }

        });

        // Keep player appearance synchronized with audio
        music.addEventListener("pause", () => {

            musicButton.classList.remove("playing");

        });

        music.addEventListener("play", () => {

            musicButton.classList.add("playing");
            musicStarted = true;

        });

    </script>

